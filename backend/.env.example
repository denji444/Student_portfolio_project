# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Email Configuration (SMTP - Recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM=noreply@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com
EMAIL_TIMEOUT=30000

# Email Provider Selection
# smtp (default) or gmail_api
EMAIL_PROVIDER=smtp

# Gmail API (OAuth) — use instead of SMTP when SMTP is blocked (e.g., on Render)
# After running getTokenWithServer.js, set the values below and switch EMAIL_PROVIDER=gmail_api
#GMAIL_CLIENT_ID=your_google_oauth_client_id
#GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
#GMAIL_REFRESH_TOKEN=your_refresh_token
#GMAIL_REDIRECT_URI=http://localhost:8888/oauth2callback
#GMAIL_SENDER=your_email@gmail.com

# Alternative Email Services (Choose One)
# 1. Gmail SMTP (easiest for development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# 2. Outlook/Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password

# 3. Yahoo Mail
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_USER=your_email@yahoo.com
# SMTP_PASS=your_app_password

# 4. Mailgun (Production Ready)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_mailgun_username
# SMTP_PASS=your_mailgun_password
# MAIL_FROM=noreply@yourdomain.com

# 5. SendGrid SMTP (Production Ready)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# MAIL_FROM=noreply@yourdomain.com

# Frontend URLs
APP_URL=http://localhost:8080
EMAIL_REDIRECT_URL=http://localhost:8080
BACKEND_URL=http://localhost:4000

# Admin Panel Credentials (required for /api/admin/*)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_JWT_SECRET=dev-secret-change-me

# Optional: Supabase Storage bucket for thumbnails (defaults to "thumbnails")
# SUPABASE_THUMBNAILS_BUCKET=thumbnails

# Notes:
# - For Gmail SMTP, you must enable 2‑Step Verification on your Google Account and use an App Password (16 chars).
# - Do NOT use your regular Gmail password.
# - In production, prefer a dedicated provider (SendGrid/Mailgun) and rotate credentials regularly.
